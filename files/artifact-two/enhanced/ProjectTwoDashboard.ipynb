# Rescue profile rules used by the scoring algorithm
RESCUE_PROFILES = {
    "water": {
        "animal_type": "Dog",
        "breeds": [
            "Labrador Retriever Mix",
            "Chesapeake Bay Retriever",
            "Newfoundland"
        ],
        "sex": "Intact Female",
